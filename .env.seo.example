# Cosmic CMS SEO / Google launch integration
# Copy only the values you use into the production .env file.

# Token only, not the full <meta> tag.
GOOGLE_SITE_VERIFICATION=

# Optional direct GA4 fallback. Example: G-XXXXXXXXXX
# If GTM is configured, install GA4 inside GTM instead of duplicating it here.
GOOGLE_ANALYTICS_ID=

# Recommended measurement container. Example: GTM-XXXXXXX
GOOGLE_TAG_MANAGER_ID=

# Optional Google Ads account ID for future conversion configuration. Example: AW-XXXXXXXXX
GOOGLE_ADS_ID=
